REPO=https://github.com/CoorenLabs/Cooren
# Server Configuration
PORT=3000
NODE_ENV=development

# Domain Masking Configuration
# Set this to your actual domain in production (e.g., api.yoursite.com)
SERVER_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Proxy Configuration
PROXY_TIMEOUT_MS=30000
PROXY_MAX_RETRIES=3
SHOW_PROXIED_URL=true

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# OpenAPI Configuration
OPENAPI_ENABLED=true
OPENAPI_VERSION=3.0.0

# Cache Config
ENABLE_CACHE=false # set `true` to enable redis cache
DEFAULT_CACHE_TTL="-1" # cache TTL in seconds, for storing forever set to "-1" 
CACHE_PROVIDER=default # `default` or `uptash`

#default
REDIS_URL=redis://localhost:6379

#uptash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# PRODUCTION SETTINGS (Uncomment for production)
# =============================================================================

# NODE_ENV=production
# LOG_LEVEL=warn
# CORS_ORIGIN=https://yoursite.com,https://api.yoursite.com
# CORS_CREDENTIALS=true
# RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable detailed logging in development
# LOG_LEVEL=debug

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Rate Limiting
ENABLE_RATE_LIMITING=false

# Request timeout (milliseconds)
REQUEST_TIMEOUT=60000

# Provider Specific Configuration
ANILIST_SPOTLIGHT_IDS=179062,195322,166613,182255,21,195515,172463,99750

# Database Configuration (for metadata remaps)
DATABASE_URL=
REMAP_REFRESH_INTERVAL=600000 # 10 minutes in ms

# =============================================================================
# ANIVEXA PROVIDER — anime episodes & stream (AniList-ID-based)
# =============================================================================

# Set to true to enable Anivexa's smartcache (in-memory + disk + Upstash Redis).
# Reuses the same UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN defined above.
CACHE_ENABLED=false

# Default Upstash Redis TTL for Anivexa cache entries (seconds, default 900 = 15min)
DEFAULT_REDIS_TTL=900

# MKissa provider: wreq-js TLS fingerprint settings (for bypassing Cloudflare)
# Leave defaults unless mkissa.to blocks you.
MKISSA_WREQ_BROWSER=chrome_149
MKISSA_WREQ_OS=windows
# Set to 1 to force wreq-js (will error instead of falling back to plain fetch)
MKISSA_WREQ_REQUIRED=0
